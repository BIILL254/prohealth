# Copy this file to .env and fill in your own values. .env is never committed.
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=prohealth
DB_USER=root
DB_PASS=

PHARMACY_NAME=ProHealth Pharmacy
PHARMACY_ADDRESS=Madaraka Estate, Nairobi, Kenya
PHARMACY_PHONE=+254 700 000 000
PHARMACY_EMAIL=info@prohealth.co.ke
DELIVERY_FEE=150

# M-Pesa: simulate (no real money), sandbox or live
MPESA_MODE=simulate
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# PayBill: CustomerPayBillOnline | Buy Goods/Till: CustomerBuyGoodsOnline
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Public HTTPS URL forwarded to this server, ending in /api/mpesa/callback
MPESA_CALLBACK_URL=
